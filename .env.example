PORT=3034
# Leave empty locally. On cPanel set API_PREFIX=ecom-back
API_PREFIX=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=bmecom
DB_SSL=false
DB_SYNCHRONIZE=true

# Auth. JWT_SECRET is required: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Used to build the links in verification and password reset emails
FRONTEND_URL=http://localhost:3000

# Mail: tried in this order. With none set, emails are logged to the console (not in production).
MAIL_FROM=
MAILEROO_SMTP_HOST=smtp.maileroo.com
MAILEROO_SMTP_PORT=587
MAILEROO_SMTP_USER=
MAILEROO_SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where product photos are stored (default: ./uploads)
# UPLOAD_DIR=uploads

# System health page: the names these apps have in pm2 list (defaults shown)
# PM2_FRONT_NAME=bmcom-front
# PM2_BACK_NAME=bmcom-back
# PM2_ADMIN_NAME=bmcom-admin
# System health page: MQTT broker to check, e.g. mqtt://localhost:1883 (reachability only)
# MQTT_URL=
